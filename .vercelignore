# Keep the Vercel upload limited to files required by the frontend build/runtime.
# Do NOT exclude src/, public/, index.html, package*.json, tsconfig*.json,
# vite.config.ts, or vercel.json.

# Contributor docs and project metadata
.github/
docs/
scripts/
tools/
readme
README*
*.md

# Tests and test-only fixtures
**/tests/
**/test/
**/*.test.*
**/*.spec.*
coverage/

# Original design/source assets and archives not served by the frontend
*.psd
*.ai
*.zip
*.7z
*.rar
*.sketch
*.fig
*.pdf

# Generic accident/junk patterns
*.bak
*.tmp
*.old
*.log
uploads/
.DS_Store

# Build/dependency/git artifacts
node_modules/
dist/
.git/
